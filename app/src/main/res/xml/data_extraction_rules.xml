<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules for Android 12+ (android:dataExtractionRules).
  The cloud credential lives in its own prefs file and is excluded from both cloud backup and
  device-to-device transfer, so it never leaves the device (add-remote-cloud-control change,
  Credential confidentiality). It can always be re-derived at home via enrolment.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aircon_remote_creds.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aircon_remote_creds.xml" />
    </device-transfer>
</data-extraction-rules>
