<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and below (android:fullBackupContent).
  The cloud credential lives in its own prefs file and must never leave the device
  (see the add-remote-cloud-control change, Credential confidentiality).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="aircon_remote_creds.xml" />
    <exclude domain="sharedpref" path="aircon_shortcut_auth.xml" />
</full-backup-content>
